@prefix : <http://w3id.org/circularfactory/FlexConveyor#> .
@prefix cfc: <http://www.sfb1574.kit.edu/core#> .
@prefix domain: <> .
@prefix kadi: <> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sp_ins: <> .
@prefix wf: <http://w3id.org/circularfactory/Workflow#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology
#################################################################

: rdf:type owl:Ontology ;
    owl:imports <http://w3id.org/circularfactory/Workflow> ;
    rdfs:label "FlexConveyor System Ontology" ;
    rdfs:comment "Domain ontology for the FlexConveyor material handling system" .

#################################################################
# Classes
#################################################################

:FlexConveyorModule rdf:type owl:Class ;
    rdfs:subClassOf cfc:Resource ;
    wf:hasWorkflow
        :ReceiveWorkflow ,
        :ReserveWorkflow ,
        :ConveyWorkflow .

:EntryModule rdf:type owl:Class ;
    rdfs:subClassOf :FlexConveyorModule .

:ExitModule rdf:type owl:Class ;
    rdfs:subClassOf :FlexConveyorModule .

:WarehouseManagementSystem rdf:type owl:Class ;
    rdfs:subClassOf cfc:Resource ;
    wf:hasWorkflow
        :SpawnBoxWorkflow ,
        :AcceptBoxWorkflow .

:Box rdf:type owl:Class .

:Connection rdf:type owl:Class .

#################################################################
# Payload Structure Definitions (Blank Nodes)
#################################################################

# Payload structures defined as labeled blank nodes with restrictions

_:ReservePayload a owl:Class ;
    owl:intersectionOf (
        [
            a owl:Restriction ;
            owl:onProperty :refersToBox ;
            owl:hasValue :Box
        ]
        [
            a owl:Restriction ;
            owl:onProperty :refersToSourceModule ;
            owl:hasValue :FlexConveyorModule
        ]
    ) .

_:ConveyPayload a owl:Class ;
    owl:intersectionOf (
        [
            a owl:Restriction ;
            owl:onProperty :refersToBox ;
            owl:hasValue :Box
        ]
        [
            a owl:Restriction ;
            owl:onProperty :refersToDestinationModule ;
            owl:hasValue :FlexConveyorModule
        ]
    ) .

_:ReceivePayload a owl:Class ;
    owl:intersectionOf (
        [
            a owl:Restriction ;
            owl:onProperty :refersToBox ;
            owl:hasValue :Box
        ]
    ) .

_:SpawnBoxPayload a owl:Class ;
    owl:intersectionOf (
        [
            a owl:Restriction ;
            owl:onProperty :refersToBox ;
            owl:hasValue :Box
        ]
        [
            a owl:Restriction ;
            owl:onProperty :refersToOriginModule ;
            owl:hasValue :FlexConveyorModule
        ]
        [
            a owl:Restriction ;
            owl:onProperty :refersToDestinationModule ;
            owl:hasValue :FlexConveyorModule
        ]
    ) .

_:AcceptBoxPayload a owl:Class ;
    owl:intersectionOf (
        [
            a owl:Restriction ;
            owl:onProperty :refersToBox ;
            owl:hasValue :Box
        ]
    ) .

#################################################################
# Response Structure Classes
#################################################################

:ReserveResponse rdf:type owl:Class ;
    rdfs:subClassOf wf:WorkflowResponse .

:ConveyResponse rdf:type owl:Class ;
    rdfs:subClassOf wf:WorkflowResponse .

:ReceiveResponse rdf:type owl:Class ;
    rdfs:subClassOf wf:WorkflowResponse .

:SpawnBoxResponse rdf:type owl:Class ;
    rdfs:subClassOf wf:WorkflowResponse .

:AcceptBoxResponse rdf:type owl:Class ;
    rdfs:subClassOf wf:WorkflowResponse .

#################################################################
# Workflow Classes
#################################################################

:ReserveWorkflow rdf:type owl:Class ;
    rdfs:subClassOf wf:Workflow ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:accepts ;
        owl:hasValue _:ReservePayload
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:receives ;
        owl:hasValue _:ReserveResponse
    ] .

:ConveyWorkflow rdf:type owl:Class ;
    rdfs:subClassOf wf:Workflow ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:accepts ;
        owl:hasValue _:ConveyPayload
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:receives ;
        owl:hasValue _:ConveyResponse
    ] .

:ReceiveWorkflow rdf:type owl:Class ;
    rdfs:subClassOf wf:Workflow ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:accepts ;
        owl:hasValue _:ReceivePayload
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:receives ;
        owl:hasValue _:ReceiveResponse
    ] .

:SpawnBoxWorkflow rdf:type owl:Class ;
    rdfs:subClassOf wf:Workflow ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:accepts ;
        owl:hasValue _:SpawnBoxPayload
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:receives ;
        owl:hasValue _:SpawnBoxResponse
    ] .

:AcceptBoxWorkflow rdf:type owl:Class ;
    rdfs:subClassOf wf:Workflow ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:accepts ;
        owl:hasValue _:AcceptBoxPayload
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty wf:receives ;
        owl:hasValue _:AcceptBoxResponse
    ] .

#################################################################
# Other Domain-Specific Classes
#################################################################

:BoxState rdf:type owl:Class .

:Created rdf:type owl:NamedIndividual, :BoxState .
:InTransit rdf:type owl:NamedIndividual, :BoxState .
:Delivered rdf:type owl:NamedIndividual, :BoxState .

:Direction rdf:type owl:Class .

:North rdf:type owl:NamedIndividual , :Direction .
:South rdf:type owl:NamedIndividual , :Direction .
:East  rdf:type owl:NamedIndividual , :Direction .
:West  rdf:type owl:NamedIndividual , :Direction .

#################################################################
# Object Properties
#################################################################

:hasConnection rdf:type owl:ObjectProperty ;
    rdfs:domain :FlexConveyorModule ;
    rdfs:range :Connection .

:connectsTo rdf:type owl:ObjectProperty ;
    rdfs:domain :Connection ;
    rdfs:range :FlexConveyorModule .

:hasPossession rdf:type owl:ObjectProperty ;
    rdfs:domain cfc:Resource ;
    rdfs:range :Box ;
    owl:inverseOf :isPossessedBy .

:isPossessedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Box ;
    rdfs:range cfc:Resource ;
    owl:inverseOf :hasPossession .

:hasOrigin rdf:type owl:ObjectProperty ;
    rdfs:domain :Box ;
    rdfs:range :FlexConveyorModule .

:hasDestination rdf:type owl:ObjectProperty ;
    rdfs:domain :Box ;
    rdfs:range :FlexConveyorModule .

:hasState rdf:type owl:ObjectProperty ;
    rdfs:domain :Box ;
    rdfs:range :BoxState .

:hasDirection rdf:type owl:ObjectProperty ;
    rdfs:domain :Connection ;
    rdfs:range :Direction .

#################################################################
# Datatype Properties
#################################################################

:onPort rdf:type owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:integer .

:hasX rdf:type owl:DatatypeProperty ;
    rdfs:domain :FlexConveyorModule ;
    rdfs:range xsd:integer .

:hasY rdf:type owl:DatatypeProperty ;
    rdfs:domain :FlexConveyorModule ;
    rdfs:range xsd:integer .

#################################################################
# Payload Field Properties
#################################################################

:refersToBox rdf:type owl:ObjectProperty ;
    rdfs:domain [
        a owl:Restriction ;
        owl:hasValue wf:Workflow ;
        owl:onProperty [ owl:inverseOf wf:accepts ]
    ] ;
    rdfs:range :Box ;
    rdfs:comment "References a box in workflow payloads" .

:refersToSourceModule rdf:type owl:ObjectProperty ;
    rdfs:domain [
        a owl:Restriction ;
        owl:hasValue wf:Workflow ;
        owl:onProperty [ owl:inverseOf wf:accepts ]
    ] ;
    rdfs:range :FlexConveyorModule ;
    rdfs:comment "References the source module in workflow payloads" .

:refersToDestinationModule rdf:type owl:ObjectProperty ;
    rdfs:domain [
        a owl:Restriction ;
        owl:hasValue wf:Workflow ;
        owl:onProperty [ owl:inverseOf wf:accepts ]
    ] ;
    rdfs:range :FlexConveyorModule ;
    rdfs:comment "References the destination module in workflow payloads" .

:refersToOriginModule rdf:type owl:ObjectProperty ;
    rdfs:domain [
        a owl:Restriction ;
        owl:hasValue wf:Workflow ;
        owl:onProperty [ owl:inverseOf wf:accepts ]
    ] ;
    rdfs:range :FlexConveyorModule ;
    rdfs:comment "References the origin module for box spawning" .
