@prefix calc: <http://demo.org/Calculator#> .
@prefix inst: <http://demo.org/CalculatorInstances#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Instance data — load into named graph:
#   <http://demo.org/CalculatorInstances>
#################################################################

inst:Calculator1 rdf:type calc:Calculator ;
    calc:hasNumberOfUses "0"^^xsd:integer .

inst:User1 rdf:type calc:User ;
    calc:hasNumberOfUses "0"^^xsd:integer .
