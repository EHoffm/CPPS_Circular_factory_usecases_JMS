@prefix : <https://sfb1574.kit.edu/ontologies/JMS_Usecase_Demo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology
#################################################################
: rdf:type owl:Ontology .


#################################################################
# Classes
#################################################################
:screw a owl:Class ;
    rdfs:subClassOf :Product ;
    rdfs:label "Screw"@en ;
    rdfs:comment "A screw is a type of fastener characterized by a helical ridge"@en .

:unscrewingOperation a owl:Class ;
    rdfs:subClassOf :Process ;
    rdfs:label "Unscrewing Process"@en ;
    rdfs:comment "The unscrewing process involves the removal of a screw from a material or object"@en .

:TimeSeriesData a owl:Class;
    rdfs:label "Time Series Data"@en ;
    rdfs:comment "A collection of data points indexed in time order, typically consisting of sequences of measurements taken at successive times."@en .

:ScrewingResource a owl:Class ;
    rdfs:subClassOf :Resource ;
    rdfs:label "Screwing Resource"@en ;
    rdfs:comment "A screwing resource is a resource used in the screwing or unscrewing process, such as a screwdriver or an angle grinder."@en .

:Anglegrinder a owl:Class ;
    rdfs:subClassOf :Product ;
    rdfs:label "Angle Grinder"@en ;
    rdfs:comment "A power tool used for cutting, grinding, and polishing materials."@en .

:Product a owl:Class ;
    rdfs:label "Product"@en ;
    rdfs:comment "A product is an item that is manufactured or refined for sale."@en .

:Transformercell a owl:Class ;
    rdfs:subClassOf :Resource ;
    rdfs:label "Transformer Cell"@en ;
    rdfs:comment "A transformer cell is a cell to work on a product"@en .


#################################################################
# Object Properties
#################################################################

:hasScrew a owl:ObjectProperty ;
    rdfs:domain :unscrewingOperation ;
    rdfs:range :screw ;
    rdfs:label "has screw"@en ;
    rdfs:comment "Links the unscrewing operation to the specific screw being removed."@en .

:hasResource a owl:ObjectProperty ;
    rdfs:domain :unscrewingOperation ;
    rdfs:range :ScrewingResource ;
    rdfs:label "has resource"@en ;
    rdfs:comment "Links the unscrewing operation to the specific resource (e.g., screwdriver) used in the process."@en .

:hasUnscrewingTorqueTimeSeriesData a owl:ObjectProperty ;
    rdfs:domain :unscrewingOperation ;
    rdfs:range :TimeSeriesData ;
    rdfs:label "has unscrewing time series data"@en ;
    rdfs:comment "Links to the time series data recorded during the unscrewing process."@en .

:hasAxialForceTimeSeriesData a owl:ObjectProperty ;
    rdfs:domain :unscrewingOperation ;
    rdfs:range :TimeSeriesData ;
    rdfs:label "has axial force time series data"@en ;
    rdfs:comment "Links to the time series data of axial force recorded during the unscrewing process."@en .

:hasRobotPositionTimeSeriesData a owl:ObjectProperty ;
    rdfs:domain :unscrewingOperation ;
    rdfs:range :TimeSeriesData ;
    rdfs:label "has position time series data"@en ;
    rdfs:comment "Links to the time series data of robot TCO position along screw axis recorded during the unscrewing process."@en .

:hasScrewingResource rdf:type owl:ObjectProperty ;
    rdfs:domain :Transformercell ;
    rdfs:range :ScrewingResource ;
    owl:inverseOf :isScrewingResourceOf .

:isScrewingResourceOf rdf:type owl:ObjectProperty ;
    rdfs:domain :ScrewingResource ;
    rdfs:range :Transformercell ;
    owl:inverseOf :hasScrewingResource .

:hasPossession a owl:ObjectProperty ;
    rdfs:domain :Transformercell ;
    rdfs:range :Anglegrinder ;
    rdfs:label "has possession"@en ;
    rdfs:comment "Indicates that the angle grinder is currently in possession of the transformer cell."@en ;
    owl:inverseOf :isPossessionBy .

:isPossessionBy a owl:ObjectProperty ;
    rdfs:domain :Anglegrinder ;
    rdfs:range :Transformercell ;
    rdfs:label "is possession by"@en ;
    rdfs:comment "Indicates that the angle grinder is currently in possession of the transformer cell."@en ;
    owl:inverseOf :hasPossession .

:hasPartScrew a owl:ObjectProperty ;
    rdfs:domain :Anglegrinder ;
    rdfs:range :screw ;
    rdfs:label "has part screw"@en ;
    rdfs:comment "Links the angle grinder to the specific screw that is part of the product being worked on."@en ;
    owl:inverseOf :isPartScrewOf .

:isPartScrewOf a owl:ObjectProperty ;
    rdfs:domain :screw ;
    rdfs:range :Anglegrinder ;
    rdfs:label "is part of"@en ;
    rdfs:comment "Indicates that the screw is a component of the angle grinder."@en ;
    owl:inverseOf :hasPartScrew .

#################################################################
# Datatype Properties
#################################################################
:hasSuccessStatus a owl:DatatypeProperty ;
    rdfs:domain :unscrewingOperation ;
    rdfs:range xsd:string ;
    rdfs:label "has successstatus"@en ;
    rdfs:comment "Indicates whether the unscrewing process was successful (true) or not (false)."@en .


:hasJSONEncodedTimeSeriesData a owl:DatatypeProperty ;
    rdfs:domain :TimeSeriesData ;
    rdfs:range xsd:string ;
    rdfs:label "has JSON encoded time series data"@en ;
    rdfs:comment "Contains the time series data in JSON format."@en .

:hasLowerTighteningTorque a owl:DatatypeProperty ;
    rdfs:domain :screw ;
    rdfs:range xsd:decimal ;
    rdfs:label "has lower tightening torque"@en ;
    rdfs:comment "Indicates the minimum torque required to properly tighten the screw. to check if torque can be applied to it."@en .

:hasUpperDynamicLoseningTorque a owl:DatatypeProperty ;
    rdfs:domain :screw ;
    rdfs:range xsd:decimal ;
    rdfs:label "has upper dynamic loosening torque"@en ;
    rdfs:comment "Specifies the maximum torque at which the screw may loosen under dynamic" .

:hasLowerAxialForce a owl:DatatypeProperty ;
    rdfs:domain :screw ;
    rdfs:range xsd:decimal ;
    rdfs:label "has lower axial force"@en ;
    rdfs:comment "minimum axial force that indicates the screw moving towards the screwdriver"@en .


:hasAxialForceApproach a owl:DatatypeProperty ;
    rdfs:domain :screw ;
    rdfs:range xsd:decimal ;
    rdfs:label "has axial force on approach"@en ;
    rdfs:comment "The axial force measured while the screwdriver approaches the screw head."@en .
		
:hasPositionOnApproach a owl:DatatypeProperty ;
    rdfs:domain :screw ;
    rdfs:range xsd:decimal ;
    rdfs:label "Position on approach"@en ;
    rdfs:comment "The position along the screw axis when approaching the screw."@en .

:hasProducer a owl:DatatypeProperty ;
    rdfs:domain :Anglegrinder ;
    rdfs:range xsd:string ;
    rdfs:label "has producer"@en ;
    rdfs:comment "Indicates the manufacturer or producer of the angle grinder."@en .

:hasProductionDate a owl:DatatypeProperty ;
    rdfs:domain :Anglegrinder ;
    rdfs:range xsd:date ;
    rdfs:label "has production date"@en ;
    rdfs:comment "Indicates the date when the angle grinder was produced."@en .

:hasCondition a owl:DatatypeProperty ;
    rdfs:domain :Anglegrinder ;
    rdfs:range xsd:string ;
    rdfs:label "has condition"@en ;
    rdfs:comment "Indicates the current condition of the angle grinder (e.g., new, used, refurbished)."@en .

:hasProductnumber a owl:DatatypeProperty ;
    rdfs:domain :Product ;
    rdfs:range xsd:string ;
    rdfs:label "has product number"@en ;
    rdfs:comment "Indicates the specific product number or model identifier for the angle grinder."@en .
